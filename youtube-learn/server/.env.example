# 이 파일을 .env 로 복사해서 값을 채우세요. (.env는 git에 올리지 마세요)

# 필수: 학습 코스를 만드는 Claude API 키
ANTHROPIC_API_KEY=

# 선택: 자막이 없는 영상을 음성 인식할 때 쓰는 OpenAI API 키 (없으면 자막 있는 영상만 분석)
OPENAI_API_KEY=

# 음성 인식 모델. gpt-transcribe(기본, 최신) 또는 whisper-1(문장 단위 타임스탬프, 2027-02-26 종료 예정)
STT_MODEL=gpt-transcribe
# 오디오를 몇 초 단위로 잘라 보낼지 (타임스탬프 간격이기도 함)
STT_CHUNK_SECONDS=180
# 음성 인식을 허용할 최대 영상 길이(분). 비용 보호용
MAX_STT_MINUTES=90

# Claude 모델
CLAUDE_MODEL=claude-opus-5-5

# 인터넷에 공개 배포할 때: 접속 암호. 비워 두면 누구나 서버의 API 키로 분석할 수 있어요
APP_TOKEN=

# 앱 화면을 다른 주소에서 띄울 때만: 허용할 출처(쉼표로 구분)
ALLOWED_ORIGINS=

# 유튜브가 서버 IP를 막을 때: 프록시 주소와 yt-dlp 쿠키 파일 경로
YT_PROXY_URL=
YTDLP_COOKIES=
